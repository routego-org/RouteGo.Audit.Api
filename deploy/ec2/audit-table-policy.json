{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AuditLogAppendAndRead",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:GetItem", "dynamodb:Query"],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:ACCOUNT_ID:table/routego-audit-log",
        "arn:aws:dynamodb:ap-south-1:ACCOUNT_ID:table/routego-audit-log/index/gsi1"
      ]
    },
    {
      "Sid": "AuditLogNeverChangesOrDeletes",
      "Effect": "Deny",
      "Action": ["dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:BatchWriteItem"],
      "Resource": "arn:aws:dynamodb:ap-south-1:ACCOUNT_ID:table/routego-audit-log"
    }
  ]
}
